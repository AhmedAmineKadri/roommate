# Example values only. Never put real credentials in a committed file.
# Docker Compose reads .env, but Spring needs these variables exported in its
# process environment (or supplied through your IDE's run configuration).
CLIENT_ID=your-github-oauth-client-id
CLIENT_SECRET=your-github-oauth-client-secret
ROOMMATE_ADMINS=your-github-username
KEYMASTER_ENABLED=false
DB_URL=jdbc:postgresql://localhost:5432/RoomMate
DB_USERNAME=user
DB_PASSWORD=iamuser
